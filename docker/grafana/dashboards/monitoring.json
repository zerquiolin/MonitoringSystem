{
  "uid": "monitoring",
  "title": "Monitoring health",
  "description": "Portable observability \u00b7 Expected inventory, explicit coverage and scope. Uptime/downtime reports follow the selected time range.",
  "schemaVersion": 40,
  "version": 2,
  "tags": [
    "portable-observability"
  ],
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s",
  "tooltip": 1,
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "uid": "prometheus",
          "type": "prometheus"
        },
        "query": "label_values(monitoring_expected_instance,project)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "uid": "prometheus",
          "type": "prometheus"
        },
        "query": "label_values(monitoring_expected_instance,service)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "uid": "prometheus",
          "type": "prometheus"
        },
        "query": "label_values(monitoring_expected_instance,environment)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "uid": "prometheus",
          "type": "prometheus"
        },
        "query": "label_values(monitoring_expected_instance,instance)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "uid": "prometheus",
          "type": "prometheus"
        },
        "query": "label_values(app_host_memory_total_bytes,hostId)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },

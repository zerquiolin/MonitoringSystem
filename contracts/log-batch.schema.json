{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$"
        },
        "service": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$"
        },
        "environment": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$"
        },
        "instance": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$"
        }
      },
      "required": [
        "project",
        "service",
        "environment",
        "instance"
      ]
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "type": "string",
            "maxLength": 64
          },
          "timestamp": {
            "type": "integer"
          },
          "severity": {
            "enum": [
              "debug",
              "info",
              "warn",
              "error",
              "fatal"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 4096
          },
          "attributes": {
            "type": "object"
          },
          "traceId": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "spanId": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$"
          }
        },
        "required": [
          "eventId",
          "timestamp",
          "severity",
          "message",
          "attributes"
        ]
      }
    }
  },
  "required": [
    "resource",
    "events"
  ]
}
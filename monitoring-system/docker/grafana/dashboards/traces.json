{
  "uid": "traces",
  "title": "Traces & dependencies",
  "description": "Portable observability \u00b7 Expected inventory, explicit coverage and scope. Uptime/downtime reports follow the selected time range.",
  "schemaVersion": 40,
  "version": 2,
  "tags": [
    "portable-observability"
  ],
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s",
  "tooltip": 1,
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "uid": "prometheus",
          "type": "prometheus"
        },
        "query": "label_values(monitoring_expected_instance,project)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "uid": "prometheus",
          "type": "prometheus"
        },
        "query": "label_values(monitoring_expected_instance,service)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "uid": "prometheus",
          "type": "prometheus"
        },
        "query": "label_values(monitoring_expected_instance,environment)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "uid": "prometheus",
          "type": "prometheus"
        },
        "query": "label_values(monitoring_expected_instance,instance)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "uid": "prometheus",
          "type": "prometheus"
        },
        "query": "label_values(app_host_memory_total_bytes,hostId)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "links": [
    {
      "title": "Overview",
      "url": "/d/overview",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Projects",
      "url": "/d/project",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Service detail",
      "url": "/d/service",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Infrastructure",
      "url": "/d/infrastructure",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Logs & errors",
      "url": "/d/logs",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Traces & dependencies",
      "url": "/d/traces",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Uptime & reliability",
      "url": "/d/incidents",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Monitoring health",
      "url": "/d/monitoring",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Stored trace search",
      "type": "traces",
      "description": "Filtered by project, service, environment and instance. Missing observations show No data.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "uid": "tempo",
        "type": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "tempo",
            "type": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.project =~ \"$project\" && resource.service.name =~ \"$service\" }",
          "limit": 30
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "links": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": []
    },
    {
      "id": 2,
      "title": "Observed calls / second",
      "type": "timeseries",
      "description": "Trace-derived observed relationships, separate from declared inventory. A slow span does not establish root cause.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "prometheus",
            "type": "prometheus"
          },
          "expr": "sum by(client,server)(rate(traces_service_graph_request_total[$__rate_interval]))",
          "legendFormat": "{{client}} \u2192 {{server}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "links": [
            {
              "title": "Service detail",
              "url": "/d/service?${project:queryparam}&var-service=${__field.labels.service}&${environment:queryparam}&${instance:queryparam}&from=${__from}&to=${__to}"
            },
            {
              "title": "Logs for this service",
              "url": "/d/logs?${project:queryparam}&var-service=${__field.labels.service}&${environment:queryparam}&from=${__from}&to=${__to}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": []
    },
    {
      "id": 3,
      "title": "Observed failed calls / second",
      "type": "timeseries",
      "description": "Filtered by project, service, environment and instance. Missing observations show No data.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "prometheus",
            "type": "prometheus"
          },
          "expr": "sum by(client,server)(rate(traces_service_graph_request_failed_total[$__rate_interval]))",
          "legendFormat": "{{client}} \u2192 {{server}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "links": [
            {
              "title": "Service detail",
              "url": "/d/service?${project:queryparam}&var-service=${__field.labels.service}&${environment:queryparam}&${instance:queryparam}&from=${__from}&to=${__to}"
            },
            {
              "title": "Logs for this service",
              "url": "/d/logs?${project:queryparam}&var-service=${__field.labels.service}&${environment:queryparam}&from=${__from}&to=${__to}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": []
    },
    {
      "id": 4,
      "title": "Declared dependencies",
      "type": "table",
      "description": "Filtered by project, service, environment and instance. Missing observations show No data.",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "uid": "control",
        "type": "yesoreyeram-infinity-datasource"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "control",
            "type": "yesoreyeram-infinity-datasource"
          },
          "type": "json",
          "source": "url",
          "url": "http://127.0.0.1:8000/api/inventory?project=${project:regex}&service=${service:regex}&environment=${environment:regex}&instance=${instance:regex}&start=${__from}&end=${__to}",
          "url_options": {
            "method": "GET",
            "data": "",
            "headers": [],
            "params": []
          },
          "parser": "backend",
          "format": "table",
          "root_selector": "",
          "columns": [
            {
              "selector": "service",
              "text": "service",
              "type": "string"
            },
            {
              "selector": "dependencies",
              "text": "dependencies",
              "type": "string"
            },
            {
              "selector": "owner",
              "text": "owner",
              "type": "string"
            },
            {
              "selector": "runbook",
              "text": "runbook",
              "type": "string"
            },
            {
              "selector": "project",
              "text": "project",
              "type": "string"
            },
            {
              "selector": "environment",
              "text": "environment",
              "type": "string"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "\u2014",
          "decimals": 2,
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Service"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.width",
                "value": 140
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Service detail",
                    "url": "/d/service?var-project=${__data.fields.Project}&var-service=${__value.raw}&var-environment=${__data.fields.Environment}&from=${__from}&to=${__to}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dependencies"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Owner"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "runbook"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Project"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Environment"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Service",
            "desc": false
          }
        ],
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "service": 0,
              "dependencies": 1,
              "owner": 2,
              "runbook": 3,
              "project": 4,
              "environment": 5
            },
            "renameByName": {
              "service": "Service",
              "dependencies": "dependencies",
              "owner": "Owner",
              "runbook": "runbook",
              "project": "Project",
              "environment": "Environment"
            }
          }
        }
      ]
    }
  ]
}

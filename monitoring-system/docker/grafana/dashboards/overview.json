    {
      "id": 6,
      "title": "Request rate",
      "type": "timeseries",
      "description": "Filtered by project, service, environment and instance. Missing observations show No data.",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "prometheus",
            "type": "prometheus"
          },
          "expr": "sum by(service)(rate(app_http_requests_total{project=~\"$project\",service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "links": [
            {
              "title": "Service detail",
              "url": "/d/service?${project:queryparam}&var-service=${__field.labels.service}&${environment:queryparam}&${instance:queryparam}&from=${__from}&to=${__to}"
            },
            {
              "title": "Logs for this service",
              "url": "/d/logs?${project:queryparam}&var-service=${__field.labels.service}&${environment:queryparam}&from=${__from}&to=${__to}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": []
    },
    {
      "id": 7,
      "title": "Request p95",
      "type": "timeseries",
      "description": "Completed request duration; compatible replica histogram buckets are summed before calculating p95. No observations means No data.",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "prometheus",
            "type": "prometheus"
          },
          "expr": "histogram_quantile(0.95,sum by(le,service)(rate(app_http_request_duration_seconds_bucket{project=~\"$project\",service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[$__rate_interval])))",

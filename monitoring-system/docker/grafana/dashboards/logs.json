{
  "uid": "logs",
  "title": "Logs & errors",
  "description": "Portable observability \u00b7 Expected inventory, explicit coverage and scope. Uptime/downtime reports follow the selected time range.",
  "schemaVersion": 40,
  "version": 2,
  "tags": [
    "portable-observability"
  ],
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s",
  "tooltip": 1,
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "uid": "prometheus",
          "type": "prometheus"
        },
        "query": "label_values(monitoring_expected_instance,project)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "uid": "prometheus",
          "type": "prometheus"
        },
        "query": "label_values(monitoring_expected_instance,service)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "uid": "prometheus",
          "type": "prometheus"
        },
        "query": "label_values(monitoring_expected_instance,environment)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "uid": "prometheus",
          "type": "prometheus"
        },
        "query": "label_values(monitoring_expected_instance,instance)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "uid": "prometheus",
          "type": "prometheus"
        },
        "query": "label_values(app_host_memory_total_bytes,hostId)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "severity",
        "label": "Severity",
        "type": "custom",
        "query": "trace,debug,info,warn,error,fatal",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "links": [
    {
      "title": "Overview",
      "url": "/d/overview",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Projects",
      "url": "/d/project",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Service detail",
      "url": "/d/service",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Infrastructure",
      "url": "/d/infrastructure",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Logs & errors",
      "url": "/d/logs",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Traces & dependencies",
      "url": "/d/traces",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Uptime & reliability",
      "url": "/d/incidents",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Monitoring health",
      "url": "/d/monitoring",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Application logs \u00b7 newest first",
      "type": "logs",
      "description": "Filtered by project, service, environment and instance. Missing observations show No data.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 14
      },
      "datasource": {
        "uid": "loki",
        "type": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "loki",
            "type": "loki"
          },
          "expr": "{project=~\"$project\",service=~\"$service\",service=~\".+\",environment=~\"$environment\"} | json | severity =~ \"$severity\"",
          "legendFormat": "{{service}} \u00b7 {{instance}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "links": []
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "transformations": []
    },
    {
      "id": 2,
      "title": "Application exceptions",
      "type": "timeseries",
      "description": "Filtered by project, service, environment and instance. Missing observations show No data.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "prometheus",
            "type": "prometheus"
          },
          "expr": "sum by(service)(rate(app_errors_total{project=~\"$project\",service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "links": [
            {
              "title": "Service detail",
              "url": "/d/service?${project:queryparam}&var-service=${__field.labels.service}&${environment:queryparam}&${instance:queryparam}&from=${__from}&to=${__to}"
            },
            {
              "title": "Logs for this service",
              "url": "/d/logs?${project:queryparam}&var-service=${__field.labels.service}&${environment:queryparam}&from=${__from}&to=${__to}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": []
    },
    {
      "id": 3,
      "title": "Dropped log events",
      "type": "timeseries",
      "description": "Filtered by project, service, environment and instance. Missing observations show No data.",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "prometheus",
            "type": "prometheus"
          },
          "expr": "sum by(service)(increase(app_telemetry_dropped_total{project=~\"$project\",service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\",signal=\"logs\"}[$__range]))",
          "legendFormat": "{{service}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "links": [
            {
              "title": "Service detail",
              "url": "/d/service?${project:queryparam}&var-service=${__field.labels.service}&${environment:queryparam}&${instance:queryparam}&from=${__from}&to=${__to}"
            },
            {
              "title": "Logs for this service",
              "url": "/d/logs?${project:queryparam}&var-service=${__field.labels.service}&${environment:queryparam}&from=${__from}&to=${__to}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": []
    },
    {
      "id": 4,
      "title": "Log export failures",
      "type": "timeseries",
      "description": "Filtered by project, service, environment and instance. Missing observations show No data.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "prometheus",
            "type": "prometheus"
          },
          "expr": "sum by(service)(rate(app_telemetry_export_failures_total{project=~\"$project\",service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\",signal=\"logs\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "links": [
            {
              "title": "Service detail",
              "url": "/d/service?${project:queryparam}&var-service=${__field.labels.service}&${environment:queryparam}&${instance:queryparam}&from=${__from}&to=${__to}"
            },
            {
              "title": "Logs for this service",
              "url": "/d/logs?${project:queryparam}&var-service=${__field.labels.service}&${environment:queryparam}&from=${__from}&to=${__to}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": []
    }
  ]
}
